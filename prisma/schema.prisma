generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  photos Photo[]
}

model Photo {
  id     Int    @id @default(autoincrement())
  postId Int
  url    String
  order  Int

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}